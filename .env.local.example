# Supabase — copy to .env.local and fill from your project (Settings → API).
# The app runs fully local-first WITHOUT these; they enable sign-in + cloud sync.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Web Push (Phase 2, server-sent reminders §87). Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Public URL only. AI credentials stay in the VPS's existing protected environment.
NEXT_PUBLIC_VPS_API_URL=https://mathspeedy.duckdns.org/istiqamah-api
